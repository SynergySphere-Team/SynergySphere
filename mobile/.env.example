# Use your computer's LAN IP for Expo Go on a physical device, never localhost.
# Keep the backend's port (4000 by default) and include the /api suffix.
# After editing this file, restart Expo with: npm run start:clean --workspace=mobile
# Example: EXPO_PUBLIC_API_URL=http://10.0.0.115:4000/api
EXPO_PUBLIC_API_URL=
