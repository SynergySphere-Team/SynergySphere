DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synergysphere"
JWT_SECRET="synergysphere-dev-secret-change-in-production"
PORT=4000
FRONTEND_URL="http://localhost:3000"
# Public mobile clients authenticate with a Bearer token issued only when they
# send X-SynergySphere-Client: mobile. Do not add database or JWT credentials
# to mobile/.env; it only needs EXPO_PUBLIC_API_URL.
# Optional: allow extra comma-separated frontend origins for direct API calls.
# FRONTEND_URLS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001"

# AI configuration
# Add one of the following to enable full AI features:

# Option 1: Google Gemini (free tier available at https://aistudio.google.com)
# GEMINI_API_KEY="AIza..."
# GEMINI_MODEL="gemini-1.5-flash"

# Option 2: OpenAI
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_TIMEOUT_MS=25000
