DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synergysphere"
JWT_SECRET="synergysphere-dev-secret-change-in-production"
PORT=4001
FRONTEND_URL="http://localhost:3000"
# Public mobile clients authenticate with a Bearer token issued only when they
# send X-SynergySphere-Client: mobile. Do not add database or JWT credentials
# to mobile/.env; it only needs EXPO_PUBLIC_API_URL.
# Optional: allow extra comma-separated frontend origins for direct API calls.
# FRONTEND_URLS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001"

# AI configuration
# Add one of the following to enable full AI features:

# Option 1: Google Gemini (free tier available at https://aistudio.google.com)
# GEMINI_API_KEY="AIza..."
# GEMINI_MODEL="gemini-1.5-flash"

# Option 2: OpenAI
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_TIMEOUT_MS=25000

# GitHub Community integration. Create an OAuth App (not a GitHub App) and use
# its client ID; Device Flow does not require a client secret in the mobile app.
# If GITHUB_OAUTH_CLIENT_ID is omitted or empty, the backend automatically runs in
# simulated development mode so all GitHub community features can be tested locally.
# Generate GITHUB_TOKEN_ENCRYPTION_KEY with: openssl rand -base64 32
# (If omitted, a fallback encryption key derived from JWT_SECRET will be used in dev)
# GITHUB_OAUTH_CLIENT_ID="Iv1..."
# GITHUB_TOKEN_ENCRYPTION_KEY="..."
# GITHUB_WEBHOOK_URL="https://api.example.com/api/github/webhooks"
# GITHUB_WEBHOOK_SECRET="a-long-random-value"
# GITHUB_ACTIVITY_POLL_INTERVAL_MS=600000
# GITHUB_ACTIVITY_POLLING=true
