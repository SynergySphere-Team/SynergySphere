{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["mobile/src/*", "frontend/src/*"]
    },
    "moduleResolution": "node",
    "jsx": "react",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "extends": "expo/tsconfig.base"
}
