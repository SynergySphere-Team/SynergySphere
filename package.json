{
  "name": "synergysphere",
  "version": "1.0.0",
  "private": true,
  "description": "SynergySphere - LMS, AI Coding Assistant, Wellness & Community Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "clean:frontend": "node scripts/clean-next.js",
    "dev:frontend": "npm run clean:frontend && npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:mobile": "concurrently --raw \"npm run dev:backend\" \"npm run start --workspace=mobile\"",
    "db:up": "docker compose up -d",
    "build": "npm run clean:frontend && npm run build --workspace=frontend && npm run build --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend"
  },
  "workspaces": [
    "frontend",
    "backend",
    "mobile"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2"
  }
}
